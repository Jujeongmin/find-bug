# Testing surfaces: ?debug, ?playtest=1, ?day= ?place= ?at=, ?lab, ?repro.
#
# Off. The build that reaches players is made by the platform out of git, and
# it runs `npm run build` — which reads this file. .env.release only applies to
# `npm run build:release`, which nothing on that path calls, so a 1 here is a
# public URL where anyone can read the answers off ?playtest=1.
#
# The dev server does not need it: import.meta.env.DEV turns the tools on by
# itself, so `npm run dev` still has every one of them.
VITE_DEV_TOOLS=0
