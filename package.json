{
  "name": "find-the-bug",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "report": "tsx scripts/report.ts && tsx scripts/report-html.ts",
    "verify": "tsc -b && tsx scripts/checkcurriculum.ts && tsx scripts/checkscenes.ts && tsx scripts/checkruntime.ts && tsx scripts/checki18n.ts && tsx scripts/checkquest.ts && tsx scripts/checkcategories.ts && tsx scripts/checkrun.ts && tsx scripts/checkads.ts && tsx scripts/footpad.ts && tsx scripts/checkzoom.ts && tsx scripts/checkyears.ts",
    "deploy": "npx -y @agent8/deploy",
    "typecheck": "tsc -b",
    "sprites": "tsx scripts/spritesheet.ts && tsx scripts/spritelist.ts",
    "build:release": "vite build --mode release",
    "recolor": "tsx scripts/recolor.ts",
    "officeart": "tsx scripts/officeart.ts",
    "critterart": "tsx scripts/critterart.ts",
    "storeart": "tsx scripts/storeart.ts",
    "footpad": "tsx scripts/footpad.ts"
  },
  "dependencies": {
    "@agent8/gameserver": "^1.10.2",
    "@verse8/ads": "^0.5.0",
    "@verse8/platform": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
